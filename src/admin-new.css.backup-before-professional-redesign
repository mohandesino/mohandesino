  font-size: 19px;
  box-shadow: inset 0 0 0 1px rgba(242,169,0,.12);
}

.admin-new-course-main strong {
  color: #172033;
  font-size: 13px;
  font-weight: 900;
}

.admin-new-course-description {
  margin-top: 4px;
  color: #8a94a6;
}

.admin-new-course-price {
  color: #344054;
  font-weight: 900;
}

