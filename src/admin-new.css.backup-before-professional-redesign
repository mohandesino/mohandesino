  color: #344054;
  font-size: 11px;
  font-weight: 800;
}

.admin-new-form-grid input,
.admin-new-form-grid select,
.admin-new-form-grid textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #dfe3e8;
  border-radius: 9px;
  background: #fff;
  color: #172033;
  padding: 10px 11px;
  font-family: inherit;
  font-size: 12px;
  outline: none;
  transition: .18s ease;
}

.admin-new-form-grid textarea {
  min-height: 82px;
  resize: vertical;
  line-height: 1.8;
}

.admin-new-form-grid input:focus,
.admin-new-form-grid select:focus,
.admin-new-form-grid textarea:focus {
  border-color: #d9b53e;
  box-shadow: 0 0 0 3px rgba(242, 201, 76, .12);
}

.admin-new-form-grid input[dir="ltr"] {
  direction: ltr;
  text-align: left;
  font-family: Arial, sans-serif;
  color: #475467;
}

.admin-new-check {
  width: fit-content;
  margin-top: 3px;
  padding: 8px 11px;
  border: 1px solid #eaecf0;
  border-radius: 9px;
  background: #fcfcfd;
  color: #475467;
  cursor: pointer;
}

.admin-new-check input {
  width: 15px;
  height: 15px;
  accent-color: #d9b53e;
}

.admin-new-form-grid + .admin-new-primary {
  margin-top: 16px;
  min-width: 130px;
}

.admin-new-empty-small {
  padding: 18px 15px;
  background: #fcfcfd;
  font-size: 11px;
}

@media (max-width: 650px) {
  .admin-new-chapter-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-new-chapter-head > div:first-child {
    width: 100%;
  }

  .admin-new-chapter-head .admin-new-course-actions {
    width: auto;
  }

  .admin-new-lesson {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .admin-new-lesson-info {
    flex: 1;
    min-width: 150px;
  }

  .admin-new-lesson .admin-new-course-actions {
    width: 100%;
    margin-right: 42px;
  }

  .admin-new-inline-form input {
    min-width: 100%;
  }
}


/* ===== Chapters — Professional UI ===== */
.admin-new-chapters {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 16px;
}

.admin-new-chapter {
  background: #fff;
  border: 1px solid #e7e9ee;
  border-radius: 14px;
  padding: 16px 18px;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
  transition: box-shadow .2s ease, border-color .2s ease, transform .2s ease;
}

.admin-new-chapter:hover {
  border-color: #d5d9e2;
  box-shadow: 0 5px 16px rgba(15, 23, 42, 0.08);
  transform: translateY(-1px);
}

.admin-new-chapter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.admin-new-chapter-head > div:first-child {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.admin-new-chapter-head strong {
  font-size: 15px;
  font-weight: 700;
  color: #172033;
}

.admin-new-chapter-head small {
  font-size: 12px;
  color: #8a93a3;
}

.admin-new-inline-form {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 14px;
  padding: 12px;
  background: #f8f9fb;
  border: 1px solid #e8ebf0;
  border-radius: 12px;
}

.admin-new-inline-form input {
  flex: 1;
  min-width: 0;
  height: 42px;
  padding: 0 13px;
  border: 1px solid #dfe3ea;
  border-radius: 9px;
  background: #fff;
  color: #172033;
  font-size: 14px;
  outline: none;
  transition: border-color .2s ease, box-shadow .2s ease;
}

.admin-new-inline-form input:focus {
  border-color: #f2b400;
  box-shadow: 0 0 0 3px rgba(242, 180, 0, 0.12);
}

.admin-new-inline-form .admin-new-primary {
  height: 42px;
  padding: 0 18px;
  border-radius: 9px;
  white-space: nowrap;
  font-size: 13px;
  font-weight: 700;
}

@media (max-width: 640px) {
  .admin-new-inline-form {
    flex-direction: column;
    align-items: stretch;
  }

  .admin-new-inline-form .admin-new-primary {
    width: 100%;
  }

  .admin-new-chapter {
    padding: 14px;
  }

  .admin-new-chapter-head {
    align-items: flex-start;
  }
}


/* =========================================================
   MOHANDESINO ADMIN — MODERN REDESIGN v1
   Visual-only override
   ========================================================= */

.admin-new-page {
  background: #f5f7fb;
  color: #172033;
}

/* =========================
   SIDEBAR
   ========================= */

.admin-new-sidebar {
  width: 255px;
  flex: 0 0 255px;
  padding: 20px 13px;
  background: #101827;
  border-left: 0;
  box-shadow: 8px 0 30px rgba(15, 23, 42, .08);
}

.admin-new-brand {
  padding: 8px 12px 20px;
  border-bottom: 1px solid rgba(255,255,255,.09);
}

.admin-new-brand strong {
  color: #fff;
  font-size: 20px;
  letter-spacing: -.3px;
}

.admin-new-brand span {
  color: #94a3b8;
  font-size: 11px;
}

.admin-new-sidebar nav {
  gap: 6px;
  margin-top: 22px;
}

.admin-new-sidebar nav button {
  min-height: 48px;
  border-radius: 12px;
  color: #aeb9ca;
  padding: 0 14px;
  font-size: 13px;
  font-weight: 700;
  text-align: right;
}

.admin-new-sidebar nav button:hover {
  background: rgba(255,255,255,.07);
  color: #fff;
  transform: translateX(-2px);
}

.admin-new-sidebar nav button.active {
  background: linear-gradient(135deg, #f2a900, #f6c343);
  color: #1d2735;
  box-shadow: 0 8px 20px rgba(242,169,0,.18);
}

.admin-new-sidebar-bottom {
  padding-top: 18px;
  border-top: 1px solid rgba(255,255,255,.09);
}

.admin-new-admin-name {
  color: #e2e8f0;
  font-size: 12px;
}

.admin-new-sidebar-bottom button {
  border-color: rgba(255,255,255,.1);
  background: rgba(255,255,255,.05);
  color: #aeb9ca;
  border-radius: 10px;
}

.admin-new-sidebar-bottom button:hover {
  background: rgba(255,255,255,.09);
  color: #fff;
}

/* =========================
   MAIN / HEADER
   ========================= */

.admin-new-main {
  background: #f5f7fb;
}

.admin-new-header {
  min-height: 82px;
  background: rgba(255,255,255,.94);
  border-bottom: 1px solid #e8ecf2;
  padding: 17px 32px;
  box-shadow: 0 2px 12px rgba(15,23,42,.025);
}

.admin-new-header h1 {
  font-size: 21px;
  font-weight: 900;
  color: #111827;
}

.admin-new-header span {
  color: #8a94a6;
}

/* =========================
   BODY
   ========================= */

.admin-new-body {
  max-width: 1380px;
  padding: 30px 32px 50px;
}

/* =========================
   STAT CARDS
   ========================= */

.admin-new-stats {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 22px;
}

.admin-new-stat {
  position: relative;
  min-height: 128px;
  padding: 21px;
  border: 1px solid #e7ebf1;
  border-radius: 17px;
  background: #fff;
  box-shadow: 0 5px 20px rgba(15,23,42,.045);
  overflow: hidden;
  transition: transform .2s ease, box-shadow .2s ease;
}

.admin-new-stat::after {
  content: "";
  position: absolute;
  left: -25px;
  bottom: -35px;
  width: 95px;
  height: 95px;
  border-radius: 50%;
  background: rgba(242,169,0,.08);
}

.admin-new-stat:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 28px rgba(15,23,42,.08);
}

.admin-new-stat span {
  position: relative;
  z-index: 1;
  display: block;
  color: #7b8798;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 13px;
}

.admin-new-stat strong {
  position: relative;
  z-index: 1;
  display: block;
  color: #111827;
  font-size: 26px;
  font-weight: 900;
  letter-spacing: -.5px;
}

/* =========================
   CARDS / SECTIONS
   ========================= */

.admin-new-section,
.admin-new-panel,
.admin-new-card {
  border-color: #e7ebf1;
  border-radius: 17px;
}

.admin-new-card {
  box-shadow: 0 5px 20px rgba(15,23,42,.035);
}

.admin-new-card-head,
.admin-new-panel-header {
  padding: 20px 22px;
}

.admin-new-card-head h2,
.admin-new-panel-header h2 {
  margin: 0;
  color: #172033;
  font-size: 15px;
  font-weight: 900;
}

.admin-new-card-head p {
  margin: 6px 0 0;
  color: #8a94a6;
  font-size: 11px;
}

/* =========================
   BUTTONS
   ========================= */

.admin-new-primary,
.admin-new-primary-btn {
  min-height: 42px;
  border-radius: 11px;
  padding: 0 17px;
  background: linear-gradient(135deg, #f2a900, #f6c343);
  color: #202a38;
  font-size: 12px;
  font-weight: 900;
  box-shadow: 0 6px 15px rgba(242,169,0,.16);
}

.admin-new-primary:hover,
.admin-new-primary-btn:hover {
  background: linear-gradient(135deg, #e99f00, #f1b832);
  transform: translateY(-2px);
  box-shadow: 0 9px 20px rgba(242,169,0,.22);
}

.admin-new-secondary,
.admin-new-secondary-btn {
  min-height: 38px;
  border-radius: 10px;
  border-color: #e1e6ee;
  color: #475467;
  font-weight: 800;
}

.admin-new-secondary:hover,
.admin-new-secondary-btn:hover {
  background: #f8fafc;
  border-color: #cfd6e1;
  transform: translateY(-1px);
}

.admin-new-danger {
  min-height: 38px;
  border-radius: 10px;
  background: #fff8f7;
  border-color: #f3d0ce;
  color: #b42318;
  font-weight: 800;
}

/* =========================
   FORMS
   ========================= */

.admin-new-form-grid {
  gap: 17px;
}

.admin-new-form-group {
  gap: 7px;
}

.admin-new-form-group label {
  color: #344054;
  font-size: 12px;
  font-weight: 800;
}

.admin-new-form-group input,
.admin-new-form-group textarea,
.admin-new-form-group select,
.admin-new-inline-form input {
  min-height: 43px;
  border: 1px solid #dce2ea;
  border-radius: 11px;
  background: #fff;
  padding: 10px 12px;
  font-size: 12px;
  transition: border-color .18s ease, box-shadow .18s ease;
}

.admin-new-form-group input:hover,
.admin-new-form-group textarea:hover,
.admin-new-form-group select:hover {
  border-color: #c7cfda;
}

.admin-new-form-group input:focus,
.admin-new-form-group textarea:focus,
.admin-new-form-group select:focus,
.admin-new-inline-form input:focus {
  border-color: #e6ad1e;
  box-shadow: 0 0 0 4px rgba(242,169,0,.11);
}

