/* =========================================================
   MOHANDESINO ADMIN PANEL
   Clean / Modern / RTL
   ========================================================= */

.admin-new-page {
  min-height: 100vh;
  display: flex;
  direction: rtl;
  background: #f7f8fa;
  color: #172033;
  font-family: inherit;
}

/* =========================
   SIDEBAR
   ========================= */

.admin-new-sidebar {
  width: 238px;
  min-height: 100vh;
  flex: 0 0 238px;
  background: #ffffff;
  border-left: 1px solid #eaecf0;
  padding: 22px 14px;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  align-self: flex-start;
  box-sizing: border-box;
}

.admin-new-brand {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 4px 10px 22px;
  border-bottom: 1px solid #f0f1f3;
}

.admin-new-brand strong {
  font-size: 19px;
  font-weight: 900;
  color: #161b26;
}

.admin-new-brand span {
  color: #98a2b3;
  font-size: 11px;
}

.admin-new-sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
  margin-top: 20px;
}

.admin-new-sidebar nav button {
  width: 100%;
  min-height: 44px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #667085;
  padding: 0 13px;
  font-family: inherit;
  font-size: 13px;
  font-weight: 600;
  text-align: right;
  cursor: pointer;
  transition: .18s ease;
}

.admin-new-sidebar nav button:hover {
  background: #f7f8fa;
  color: #344054;
}

.admin-new-sidebar nav button.active {
  background: #fff8dc;
  color: #795d00;
  font-weight: 800;
}

.admin-new-sidebar-bottom {
  margin-top: auto;
  padding-top: 16px;
  border-top: 1px solid #f0f1f3;
}

.admin-new-admin-name {
  color: #344054;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 9px;
}

.admin-new-sidebar-bottom button {
  width: 100%;
  border: 1px solid #eaecf0;
  background: #fff;
  color: #667085;
  border-radius: 9px;
  padding: 9px 12px;
  font-family: inherit;
  font-size: 12px;
  cursor: pointer;
  transition: .18s ease;
}

.admin-new-sidebar-bottom button:hover {
  background: #f9fafb;
  color: #344054;
}

/* =========================
   MAIN
   ========================= */

.admin-new-main {
  flex: 1;
  min-width: 0;
  background: #f7f8fa;
}

.admin-new-header {
  min-height: 78px;
  box-sizing: border-box;
  background: #ffffff;
  border-bottom: 1px solid #eaecf0;
  padding: 16px 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.admin-new-header h1 {
  margin: 0 0 4px;
  font-size: 20px;
  font-weight: 800;
  color: #161b26;
}

.admin-new-header span {
  color: #98a2b3;
  font-size: 11px;
}

.admin-new-loading {
  color: #98a2b3;
  font-size: 11px;
}

/* =========================
   COMMON CONTENT
   ========================= */

.admin-new-body {
  width: 100%;
  max-width: 1250px;
  box-sizing: border-box;
  margin: 0 auto;
  padding: 26px 30px 40px;
}

.admin-new-welcome {
  background: #ffffff;
  border: 1px solid #eaecf0;
  border-radius: 16px;
  padding: 22px 24px;
  margin-bottom: 18px;
}

.admin-new-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 13px;
  margin-bottom: 18px;
}

.admin-new-stat,
.admin-new-stat-card {
  background: #ffffff;
  border: 1px solid #eaecf0;
  border-radius: 14px;
  padding: 17px;
  box-sizing: border-box;
}

.admin-new-section,
.admin-new-panel {
  background: #ffffff;
  border: 1px solid #eaecf0;
  border-radius: 15px;
  overflow: hidden;
  margin-bottom: 18px;
}

.admin-new-card {
  background: #ffffff;
  border: 1px solid #eaecf0;
  border-radius: 14px;
  padding: 18px;
}

.admin-new-card-head,
.admin-new-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 17px 20px;
  border-bottom: 1px solid #f0f1f3;
}

.admin-new-panel-header {
  margin: 0;
}

/* =========================
   BUTTONS
   ========================= */

.admin-new-primary,
.admin-new-primary-btn {
  border: 0;
  border-radius: 9px;
  background: #f2c94c;
  color: #3d3000;
  padding: 9px 14px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition: .18s ease;
}

.admin-new-primary:hover,
.admin-new-primary-btn:hover {
  background: #edc23b;
  transform: translateY(-1px);
}

.admin-new-secondary,
.admin-new-secondary-btn {
  border: 1px solid #e4e7ec;
  border-radius: 9px;
  background: #ffffff;
  color: #475467;
  padding: 8px 13px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: .18s ease;
}

.admin-new-secondary:hover,
.admin-new-secondary-btn:hover {
  background: #f9fafb;
}

.admin-new-danger {
  border: 1px solid #f3d0ce;
  border-radius: 9px;
  background: #fffafa;
  color: #b42318;
  padding: 8px 12px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

/* =========================
   COURSES
   ========================= */

.admin-new-course-list {
  background: #ffffff;
}

.admin-new-course-row {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 15px 19px;
  border-bottom: 1px solid #f0f1f3;
  transition: background .15s ease;
}

.admin-new-course-row:last-child {
  border-bottom: 0;
}

.admin-new-course-row:hover {
  background: #fcfcfd;
}

.admin-new-course-main {
  flex: 1;
  min-width: 0;
}

.admin-new-course-actions {
  display: flex;
  align-items: center;
  gap: 7px;
  flex-wrap: wrap;
}

.admin-new-course-icon {
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  border-radius: 11px;
  background: #fff8dc;
  color: #8a6900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-new-course-info {
  min-width: 0;
}

.admin-new-course-description {
  color: #98a2b3;
  font-size: 11px;
}

.admin-new-course-price {
  color: #475467;
  font-size: 12px;
  font-weight: 800;
}

/* =========================
   CHAPTERS / LESSONS
   ========================= */

.admin-new-chapters {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.admin-new-chapter {
  background: #ffffff;
  border: 1px solid #e4e7ec;
  border-radius: 12px;
  overflow: hidden;
}

.admin-new-chapter-head,
.admin-new-chapter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 13px 15px;
}

.admin-new-chapter-title {
  font-size: 13px;
  font-weight: 800;
  color: #344054;
}

.admin-new-chapter-meta {
  color: #98a2b3;
  font-size: 11px;
}

.admin-new-lessons {
  display: flex;
  flex-direction: column;
}

.admin-new-lesson {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 11px 14px;
  border-top: 1px solid #f0f1f3;
}

.admin-new-lesson-info {
  flex: 1;
  min-width: 0;
}

.admin-new-lesson-number {
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  border-radius: 8px;
  background: #f7f8fa;
  color: #667085;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 800;
}

/* =========================
   FORMS
   ========================= */

.admin-new-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.admin-new-form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.admin-new-form-group label {
  color: #344054;
  font-size: 12px;
  font-weight: 700;
}

.admin-new-form-group input,
.admin-new-form-group textarea,
.admin-new-form-group select {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #dfe3e8;
  border-radius: 9px;
  background: #fff;
  color: #172033;
  padding: 10px 11px;
  font-family: inherit;
  font-size: 12px;
  outline: none;
  transition: .18s ease;
}

.admin-new-form-group input:focus,
.admin-new-form-group textarea:focus,
.admin-new-form-group select:focus {
  border-color: #d9b53e;
  box-shadow: 0 0 0 3px rgba(242, 201, 76, .12);
}

.admin-new-form-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 16px;
}

.admin-new-inline-form {
  display: flex;
  align-items: center;
  gap: 9px;
  flex-wrap: wrap;
}

.admin-new-check {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
}

.admin-new-full {
  grid-column: 1 / -1;
}

.admin-new-number {
  direction: ltr;
}

/* =========================
   STATES / TEXT
   ========================= */

.admin-new-message {
  margin: 11px 0;
  padding: 9px 11px;
  border-radius: 9px;
  background: #fff8ed;
  border: 1px solid #f6dfc1;
  color: #9a3412;
  font-size: 12px;
}

.admin-new-message-top {
  margin-bottom: 14px;
}

.admin-new-muted {
  color: #98a2b3;
  font-size: 11px;
}

.admin-new-empty,
.admin-new-empty-small {
  padding: 30px 20px;
  text-align: center;
  color: #98a2b3;
  font-size: 12px;
}

/* =========================
   LOGIN
   ========================= */

.admin-new-login {
  width: min(390px, calc(100% - 32px));
  margin: auto;
  padding: 30px;
  box-sizing: border-box;
  background: #ffffff;
  border: 1px solid #eaecf0;
  border-radius: 17px;
  box-shadow: 0 12px 35px rgba(16, 24, 40, .06);
}

.admin-new-login-logo {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: #f2c94c;
  color: #3d3000;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 900;
  margin-bottom: 17px;
}

.admin-new-login h1 {
  margin: 0 0 7px;
  font-size: 20px;
  color: #161b26;
}

.admin-new-login p {
  margin: 0 0 22px;
  color: #98a2b3;
  font-size: 12px;
  line-height: 1.8;
}

.admin-new-login form {
  display: flex;
  flex-direction: column;
}

.admin-new-login form label {
  margin-bottom: 6px;
  color: #344054;
  font-size: 12px;
  font-weight: 700;
}

.admin-new-login form input {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 14px;
  border: 1px solid #dfe3e8;
  border-radius: 9px;
  padding: 11px 12px;
  background: #fff;
  font-family: inherit;
  outline: none;
}

.admin-new-login form input:focus {
  border-color: #d9b53e;
  box-shadow: 0 0 0 3px rgba(242, 201, 76, .12);
}

.admin-new-login form button {
  border: 0;
  border-radius: 9px;
  padding: 11px 14px;
  background: #f2c94c;
  color: #3d3000;
  font-family: inherit;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}

/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 900px) {
  .admin-new-page {
    display: block;
  }

  .admin-new-sidebar {
    width: 100%;
    min-height: auto;
    position: static;
    border-left: 0;
    border-bottom: 1px solid #eaecf0;
  }

  .admin-new-sidebar nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .admin-new-sidebar-bottom {
    margin-top: 14px;
  }

  .admin-new-body {
    padding: 22px 18px 32px;
  }
}

@media (max-width: 650px) {
  .admin-new-header {
    padding: 14px 16px;
  }

  .admin-new-stats {
    grid-template-columns: 1fr;
  }

  .admin-new-form-grid {
    grid-template-columns: 1fr;
  }

  .admin-new-full {
    grid-column: auto;
  }

  .admin-new-sidebar nav {
    grid-template-columns: repeat(2, 1fr);
  }

  .admin-new-course-row {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .admin-new-course-actions {
    width: 100%;
  }

  .admin-new-login {
    padding: 24px;
  }
}

/* =========================================================
   COURSES - POLISHED UI
   ========================================================= */

.admin-new-chapters {
  gap: 14px;
}

.admin-new-chapter {
  border: 1px solid #e3e6eb;
  border-radius: 15px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(16, 24, 40, .025);
}

.admin-new-chapter-head {
  min-height: 58px;
  box-sizing: border-box;
  padding: 13px 16px;
  background: #fcfcfd;
}

.admin-new-chapter-head > div:first-child {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.admin-new-number {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 9px;
  background: #fff5c9;
  color: #755b00;
  font-size: 11px;
  font-weight: 900;
}

.admin-new-chapter-head strong {
  color: #1d2939;
  font-size: 13px;
  font-weight: 800;
}

.admin-new-chapter-head small {
  color: #98a2b3;
  font-size: 11px;
  margin-right: 2px;
}

.admin-new-lessons {
  background: #fff;
}

.admin-new-lesson {
  min-height: 58px;
  box-sizing: border-box;
  padding: 10px 15px;
  gap: 12px;
  border-top: 1px solid #f0f1f3;
  transition: background .15s ease;
}

.admin-new-lesson:hover {
  background: #fafbfc;
}

.admin-new-lesson-number {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  border-radius: 8px;
  background: #f4f5f7;
  color: #667085;
  font-size: 10px;
}

.admin-new-lesson-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-new-lesson-info strong {
  color: #344054;
  font-size: 12px;
  font-weight: 750;
}

.admin-new-lesson-info span {
  color: #98a2b3;
  font-size: 10px;
}

.admin-new-lesson-info span::first-letter {
  color: #667085;
}

/* Course action buttons */
.admin-new-course-actions {
  gap: 6px;
}

.admin-new-course-actions .admin-new-secondary,
.admin-new-course-actions .admin-new-danger {
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 10px;
}

/* Add / edit chapter */
.admin-new-inline-form {
  padding-top: 2px;
}

.admin-new-inline-form input {
  flex: 1;
  min-width: 220px;
  box-sizing: border-box;
  border: 1px solid #dfe3e8;
  border-radius: 9px;
  background: #fff;
  color: #172033;
  padding: 10px 11px;
  font-family: inherit;
  font-size: 12px;
  outline: none;
  transition: .18s ease;
}

.admin-new-inline-form input:focus {
  border-color: #d9b53e;
  box-shadow: 0 0 0 3px rgba(242, 201, 76, .12);
}

/* Lesson form */
.admin-new-form-grid > div {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.admin-new-form-grid > div > label {
  color: #344054;
  font-size: 11px;
  font-weight: 800;
}

.admin-new-form-grid input,
.admin-new-form-grid select,
.admin-new-form-grid textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #dfe3e8;
  border-radius: 9px;
  background: #fff;
  color: #172033;
  padding: 10px 11px;
  font-family: inherit;
  font-size: 12px;
  outline: none;
  transition: .18s ease;
}

.admin-new-form-grid textarea {
  min-height: 82px;
  resize: vertical;
  line-height: 1.8;
}

.admin-new-form-grid input:focus,
.admin-new-form-grid select:focus,
.admin-new-form-grid textarea:focus {
  border-color: #d9b53e;
  box-shadow: 0 0 0 3px rgba(242, 201, 76, .12);
}

/* Video URL */
.admin-new-form-grid input[dir="ltr"] {
  direction: ltr;
  text-align: left;
  font-family: Arial, sans-serif;
  color: #475467;
}

.admin-new-form-grid input[dir="ltr"]::placeholder {
  color: #98a2b3;
}

/* Free lesson checkbox */
.admin-new-check {
  width: fit-content;
  margin-top: 3px;
  padding: 8px 11px;
  border: 1px solid #eaecf0;
  border-radius: 9px;
  background: #fcfcfd;
  color: #475467;
  cursor: pointer;
}

.admin-new-check input {
  width: 15px;
  height: 15px;
  accent-color: #d9b53e;
}

/* Main save button */
.admin-new-form-grid + .admin-new-primary {
  margin-top: 16px;
  min-width: 130px;
}

/* Empty lesson state */
.admin-new-empty-small {
  padding: 18px 15px;
  background: #fcfcfd;
  font-size: 11px;
}

/* Mobile course details */
@media (max-width: 650px) {
  .admin-new-chapter-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-new-chapter-head > div:first-child {
    width: 100%;
  }

  .admin-new-chapter-head .admin-new-course-actions {
    width: auto;
  }

  .admin-new-lesson {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .admin-new-lesson-info {
    flex: 1;
    min-width: 150px;
  }

  .admin-new-lesson .admin-new-course-actions {
    width: 100%;
    margin-right: 42px;
  }

  .admin-new-inline-form input {
    min-width: 100%;
  }
}


