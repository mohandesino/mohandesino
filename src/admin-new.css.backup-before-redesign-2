  color: #344054;
  font-size: 11px;
  font-weight: 800;
}

.admin-new-form-grid input,
.admin-new-form-grid select,
.admin-new-form-grid textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #dfe3e8;
  border-radius: 9px;
  background: #fff;
  color: #172033;
  padding: 10px 11px;
  font-family: inherit;
  font-size: 12px;
  outline: none;
  transition: .18s ease;
}

.admin-new-form-grid textarea {
  min-height: 82px;
  resize: vertical;
  line-height: 1.8;
}

.admin-new-form-grid input:focus,
.admin-new-form-grid select:focus,
.admin-new-form-grid textarea:focus {
  border-color: #d9b53e;
  box-shadow: 0 0 0 3px rgba(242, 201, 76, .12);
}

.admin-new-form-grid input[dir="ltr"] {
  direction: ltr;
  text-align: left;
  font-family: Arial, sans-serif;
  color: #475467;
}

.admin-new-check {
  width: fit-content;
  margin-top: 3px;
  padding: 8px 11px;
  border: 1px solid #eaecf0;
  border-radius: 9px;
  background: #fcfcfd;
  color: #475467;
  cursor: pointer;
}

.admin-new-check input {
  width: 15px;
  height: 15px;
  accent-color: #d9b53e;
}

.admin-new-form-grid + .admin-new-primary {
  margin-top: 16px;
  min-width: 130px;
}

.admin-new-empty-small {
  padding: 18px 15px;
  background: #fcfcfd;
  font-size: 11px;
}

@media (max-width: 650px) {
  .admin-new-chapter-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-new-chapter-head > div:first-child {
    width: 100%;
  }

  .admin-new-chapter-head .admin-new-course-actions {
    width: auto;
  }

  .admin-new-lesson {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .admin-new-lesson-info {
    flex: 1;
    min-width: 150px;
  }

  .admin-new-lesson .admin-new-course-actions {
    width: 100%;
    margin-right: 42px;
  }

  .admin-new-inline-form input {
    min-width: 100%;
  }
}


/* ===== Chapters — Professional UI ===== */
.admin-new-chapters {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 16px;
}

.admin-new-chapter {
  background: #fff;
  border: 1px solid #e7e9ee;
  border-radius: 14px;
  padding: 16px 18px;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
  transition: box-shadow .2s ease, border-color .2s ease, transform .2s ease;
}

.admin-new-chapter:hover {
  border-color: #d5d9e2;
  box-shadow: 0 5px 16px rgba(15, 23, 42, 0.08);
  transform: translateY(-1px);
}

.admin-new-chapter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.admin-new-chapter-head > div:first-child {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.admin-new-chapter-head strong {
  font-size: 15px;
  font-weight: 700;
  color: #172033;
}

.admin-new-chapter-head small {
  font-size: 12px;
  color: #8a93a3;
}

.admin-new-inline-form {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 14px;
  padding: 12px;
  background: #f8f9fb;
  border: 1px solid #e8ebf0;
  border-radius: 12px;
}

.admin-new-inline-form input {
  flex: 1;
  min-width: 0;
  height: 42px;
  padding: 0 13px;
  border: 1px solid #dfe3ea;
  border-radius: 9px;
  background: #fff;
  color: #172033;
  font-size: 14px;
  outline: none;
  transition: border-color .2s ease, box-shadow .2s ease;
}

.admin-new-inline-form input:focus {
  border-color: #f2b400;
  box-shadow: 0 0 0 3px rgba(242, 180, 0, 0.12);
}

.admin-new-inline-form .admin-new-primary {
  height: 42px;
  padding: 0 18px;
  border-radius: 9px;
  white-space: nowrap;
  font-size: 13px;
  font-weight: 700;
}

@media (max-width: 640px) {
  .admin-new-inline-form {
    flex-direction: column;
    align-items: stretch;
  }

  .admin-new-inline-form .admin-new-primary {
    width: 100%;
  }

  .admin-new-chapter {
    padding: 14px;
  }

  .admin-new-chapter-head {
    align-items: flex-start;
  }
}

