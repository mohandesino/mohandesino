/* =========================================================
   MOHANDESINO ADMIN PANEL
   Clean / Compact / Professional
   ========================================================= */

:root {
  --admin-bg: #f6f7fb;
  --admin-card: #ffffff;
  --admin-text: #172033;
  --admin-muted: #7b8496;
  --admin-border: #e7eaf0;
  --admin-dark: #151a24;
  --admin-dark-2: #1d2430;
  --admin-yellow: #f4c430;
  --admin-yellow-dark: #d9a900;
  --admin-danger: #dc3545;
  --admin-success: #16845b;
  --admin-radius: 14px;
  --admin-shadow: 0 8px 25px rgba(15, 23, 42, .06);
}

* {
  box-sizing: border-box;
}

.admin-new-page {
  min-height: 100vh;
  background: var(--admin-bg);
  color: var(--admin-text);
  direction: rtl;
  font-family: inherit;
}

/* =========================================================
   LOGIN
   ========================================================= */

.admin-new-login {
  width: min(430px, calc(100% - 32px));
  margin: 0 auto;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.admin-new-login-logo {
  width: 64px;
  height: 64px;
  display: grid;
  place-items: center;
  margin: 0 auto 20px;
  border-radius: 18px;
  background: var(--admin-yellow);
  color: #171717;
  font-size: 22px;
  font-weight: 900;
  box-shadow: 0 10px 25px rgba(244, 196, 48, .25);
}

.admin-new-login h1 {
  margin: 0 0 8px;
  text-align: center;
  font-size: 25px;
  font-weight: 900;
}

.admin-new-login > p {
  margin: 0 0 24px;
  text-align: center;
  color: var(--admin-muted);
  font-size: 13px;
}

.admin-new-login form {
  background: #fff;
  border: 1px solid var(--admin-border);
  border-radius: 18px;
  padding: 26px;
  box-shadow: 0 15px 45px rgba(15, 23, 42, .08);
}

.admin-new-login label {
  display: block;
  margin: 0 0 7px;
  font-size: 13px;
  font-weight: 700;
}

.admin-new-login input {
  width: 100%;
  height: 45px;
  margin: 0 0 16px;
  padding: 0 13px;
  border: 1px solid #dfe3ea;
  border-radius: 10px;
  background: #fff;
  color: var(--admin-text);
  font: inherit;
  outline: none;
  transition: .2s;
}

.admin-new-login input:focus {
  border-color: var(--admin-yellow-dark);
  box-shadow: 0 0 0 3px rgba(244, 196, 48, .14);
}

.admin-new-login form > button {
  width: 100%;
  height: 45px;
  margin-top: 4px;
  border: 0;
  border-radius: 10px;
  background: var(--admin-yellow);
  color: #171717;
  font: inherit;
  font-weight: 900;
  cursor: pointer;
  transition: .2s;
}

.admin-new-login form > button:hover {
  background: #e7b514;
  transform: translateY(-1px);
}

.admin-new-login form > button:disabled {
  opacity: .65;
  cursor: not-allowed;
  transform: none;
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.admin-new-sidebar {
  position: fixed;
  inset: 0 0 0 auto;
  width: 235px;
  padding: 20px 13px;
  background: var(--admin-dark);
  color: #fff;
  display: flex;
  flex-direction: column;
  border-left: 1px solid #252c38;
  z-index: 50;
}

.admin-new-brand {
  padding: 7px 11px 20px;
  margin-bottom: 14px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.admin-new-brand strong {
  display: block;
  color: #fff;
  font-size: 18px;
  font-weight: 900;
}

.admin-new-brand span {
  display: block;
  margin-top: 4px;
  color: #929aaa;
  font-size: 11px;
}

.admin-new-sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.admin-new-sidebar nav button {
  width: 100%;
  min-height: 45px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 13px;
  border: 0;
  border-radius: 11px;
  background: transparent;
  color: #aeb7c7;
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  text-align: right;
  cursor: pointer;
  transition: .2s;
}

.admin-new-sidebar nav button:hover {
  background: rgba(255,255,255,.07);
  color: #fff;
}

.admin-new-sidebar nav button.active {
  background: var(--admin-yellow);
  color: #171717;
  font-weight: 900;
  box-shadow: 0 5px 16px rgba(244,196,48,.16);
}

.admin-new-sidebar-bottom {
  margin-top: auto;
  padding-top: 15px;
  border-top: 1px solid rgba(255,255,255,.08);
}

.admin-new-admin-name {
  padding: 8px 10px 11px;
  color: #dce1e9;
  font-size: 12px;
  font-weight: 700;
}

.admin-new-sidebar-bottom > button {
  width: 100%;
  height: 40px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 9px;
  background: transparent;
  color: #aeb7c7;
  font: inherit;
  font-size: 12px;
  cursor: pointer;
  transition: .2s;
}

.admin-new-sidebar-bottom > button:hover {
  background: rgba(220,53,69,.12);
  border-color: rgba(220,53,69,.35);
  color: #ff9aa3;
}

/* =========================================================
   MAIN / HEADER
   ========================================================= */

.admin-new-main {
  min-height: 100vh;
  margin-right: 235px;
}

.admin-new-header {
  position: sticky;
  top: 0;
  z-index: 30;
  min-height: 74px;
  padding: 0 28px;
  background: rgba(255,255,255,.96);
  border-bottom: 1px solid var(--admin-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  backdrop-filter: blur(10px);
}

.admin-new-header h1 {
  margin: 0 0 4px;
  font-size: 20px;
  font-weight: 900;
}

.admin-new-header span {
  color: var(--admin-muted);
  font-size: 11px;
}

.admin-new-loading {
  padding: 7px 11px;
  border-radius: 8px;
  background: #fff7d6;
  color: #765b00;
  font-size: 11px;
  font-weight: 700;
}

/* =========================================================
   CONTENT / ALERTS
   ========================================================= */

.admin-new-section {
  width: min(1400px, 100%);
  margin: 0 auto;
  padding: 25px 28px;
}

.admin-new-message {
  border-radius: 10px;
  padding: 11px 13px;
  background: #fff7d6;
  border: 1px solid #f0d77c;
  color: #715900;
  font-size: 13px;
}

.admin-new-message-top {
  margin: 18px 28px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.admin-new-message button {
  width: 27px;
  height: 27px;
  border: 0;
  border-radius: 7px;
  background: rgba(0,0,0,.06);
  cursor: pointer;
  font-size: 17px;
}

/* =========================================================
   STATS
   ========================================================= */

.admin-new-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 22px;
}

.admin-new-stat {
  min-height: 105px;
  padding: 18px;
  background: var(--admin-card);
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius);
  box-shadow: var(--admin-shadow);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.admin-new-stat span {
  color: var(--admin-muted);
  font-size: 12px;
  font-weight: 600;
}

.admin-new-stat strong {
  font-size: 27px;
  line-height: 1;
  font-weight: 900;
}

/* =========================================================
   CARDS
   ========================================================= */

.admin-new-card {
  background: var(--admin-card);
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius);
  box-shadow: var(--admin-shadow);
  overflow: hidden;
}

.admin-new-card + .admin-new-card {
  margin-top: 16px;
}

.admin-new-card-head {
  min-height: 62px;
  padding: 13px 17px;
  border-bottom: 1px solid var(--admin-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.admin-new-card-head h2,
.admin-new-card-head h3 {
  margin: 0;
  font-size: 15px;
  font-weight: 900;
}

.admin-new-card-head p {
  margin: 3px 0 0;
  color: var(--admin-muted);
  font-size: 11px;
}

/* =========================================================
   BUTTONS
   ========================================================= */

.admin-new-primary,
.admin-new-secondary,
.admin-new-danger,
.admin-new-back {
  min-height: 36px;
  padding: 0 13px;
  border-radius: 9px;
  font: inherit;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition: .18s;
}

.admin-new-primary {
  border: 1px solid var(--admin-yellow);
  background: var(--admin-yellow);
  color: #171717;
}

.admin-new-primary:hover {
  background: #e5b20f;
  transform: translateY(-1px);
}

.admin-new-secondary,
.admin-new-back {
  border: 1px solid #dfe3ea;
  background: #fff;
  color: #394150;
}

.admin-new-secondary:hover,
.admin-new-back:hover {
  background: #f5f6f8;
  border-color: #cfd5df;
}

.admin-new-danger {
  border: 1px solid #f0c3c8;
  background: #fff;
  color: var(--admin-danger);
}

.admin-new-danger:hover {
  background: #fff0f1;
}

.admin-new-primary:disabled,
.admin-new-secondary:disabled,
.admin-new-danger:disabled {
  opacity: .6;
  cursor: not-allowed;
}

/* =========================================================
   FORMS
   ========================================================= */

.admin-new-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15px;
  padding: 18px;
}

.admin-new-form-grid label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  color: #394150;
  font-size: 12px;
  font-weight: 700;
}

.admin-new-form-grid input,
.admin-new-form-grid textarea,
.admin-new-form-grid select {
  width: 100%;
  min-height: 40px;
  padding: 8px 11px;
  border: 1px solid #dfe3ea;
  border-radius: 9px;
  background: #fff;
  color: var(--admin-text);
  font: inherit;
  font-size: 12px;
  outline: none;
  transition: .18s;
}

.admin-new-form-grid textarea {
  min-height: 90px;
  resize: vertical;
}

.admin-new-form-grid input:focus,
.admin-new-form-grid textarea:focus,
.admin-new-form-grid select:focus {
  border-color: var(--admin-yellow-dark);
  box-shadow: 0 0 0 3px rgba(244,196,48,.12);
}

.admin-new-full {
  grid-column: 1 / -1;
}

.admin-new-check {
  display: flex !important;
  flex-direction: row !important;
  align-items: center;
  gap: 8px !important;
  cursor: pointer;
}

.admin-new-check input {
  width: 17px !important;
  min-height: 17px !important;
}

/* =========================================================
   INLINE FORM
   ========================================================= */

.admin-new-inline-form {
  display: flex;
  align-items: end;
  gap: 10px;
  padding: 16px 18px;
  border-bottom: 1px solid var(--admin-border);
}

.admin-new-inline-form label {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6px;
  color: #394150;
  font-size: 12px;
  font-weight: 700;
}

.admin-new-inline-form input {
  height: 39px;
  padding: 0 10px;
  border: 1px solid #dfe3ea;
  border-radius: 9px;
  font: inherit;
  outline: none;
}

/* =========================================================
   COURSE LIST
   ========================================================= */

.admin-new-course-list {
  padding: 7px 17px;
}

.admin-new-course-row {
  min-height: 72px;
  padding: 11px 0;
  border-bottom: 1px solid #edf0f4;
  display: flex;
  align-items: center;
  gap: 13px;
}

.admin-new-course-row:last-child {
  border-bottom: 0;
}

.admin-new-course-main {
  flex: 1;
  min-width: 0;
  cursor: pointer;
}

.admin-new-course-icon {
  width: 43px;
  height: 43px;
  flex: 0 0 43px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: #fff5c9;
  font-size: 19px;
}

.admin-new-course-main strong {
  display: block;
  margin-bottom: 4px;
  font-size: 13px;
  font-weight: 900;
}

.admin-new-course-main span {
  color: var(--admin-muted);
  font-size: 11px;
}

.admin-new-course-actions {
  display: flex;
  align-items: center;
  gap: 6px;
}

/* =========================================================
   CHAPTERS / LESSONS
   ========================================================= */

.admin-new-chapters {
  padding: 16px 18px;
}

.admin-new-chapter {
  border: 1px solid var(--admin-border);
  border-radius: 12px;
  overflow: hidden;
}

.admin-new-chapter + .admin-new-chapter {
  margin-top: 11px;
}

.admin-new-chapter-head {
  min-height: 56px;
  padding: 9px 12px;
  background: #fafbfc;
  display: flex;
  align-items: center;
  gap: 10px;
}

.admin-new-number {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: var(--admin-yellow);
  color: #171717;
  font-size: 12px;
  font-weight: 900;
}

.admin-new-chapter-head strong {
  flex: 1;
  font-size: 13px;
}

.admin-new-lessons {
  padding: 5px 12px;
}

.admin-new-lesson {
  min-height: 48px;
  padding: 8px 0;
  border-bottom: 1px solid #edf0f4;
  display: flex;
  align-items: center;
  gap: 10px;
}

.admin-new-lesson:last-child {
  border-bottom: 0;
}

.admin-new-lesson-number {
  width: 25px;
  height: 25px;
  flex: 0 0 25px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: #eef1f5;
  color: #697386;
  font-size: 10px;
  font-weight: 800;
}

.admin-new-lesson-info {
  flex: 1;
  min-width: 0;
}

.admin-new-lesson-info strong {
  display: block;
  font-size: 12px;
  font-weight: 800;
}

.admin-new-lesson-info span {
  display: block;
  margin-top: 2px;
  color: var(--admin-muted);
  font-size: 10px;
}

.admin-new-empty,
.admin-new-empty-small {
  text-align: center;
  color: var(--admin-muted);
}

.admin-new-empty {
  padding: 35px 20px;
  font-size: 13px;
}

.admin-new-empty-small {
  padding: 18px 10px;
  font-size: 11px;
}

/* =========================================================
   MUTED TEXT / COMMON
   ========================================================= */

.admin-new-muted {
  color: var(--admin-muted);
  font-size: 12px;
}

.admin-new-card > .admin-new-muted {
  padding: 20px;
  margin: 0;
}

.admin-new-section > .admin-new-card + .admin-new-card {
  margin-top: 16px;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {
  .admin-new-sidebar {
    width: 205px;
  }

  .admin-new-main {
    margin-right: 205px;
  }

  .admin-new-section {
    padding: 20px;
  }

  .admin-new-header {
    padding: 0 20px;
  }

  .admin-new-stats {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 650px) {
  .admin-new-sidebar {
    position: static;
    width: 100%;
    min-height: auto;
    padding: 12px;
  }

  .admin-new-brand {
    padding: 6px 8px 12px;
    margin-bottom: 8px;
  }

  .admin-new-sidebar nav {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .admin-new-sidebar-bottom {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding-top: 10px;
  }

  .admin-new-admin-name {
    flex: 1;
    padding: 0 8px;
  }

  .admin-new-sidebar-bottom > button {
    width: 90px;
  }

  .admin-new-main {
    margin-right: 0;
  }

  .admin-new-header {
    position: static;
    min-height: 68px;
    padding: 0 15px;
  }

  .admin-new-header h1 {
    font-size: 17px;
  }

  .admin-new-section {
    padding: 15px;
  }

  .admin-new-message-top {
    margin: 14px 15px 0;
  }

  .admin-new-stats {
    gap: 9px;
    margin-bottom: 15px;
  }

  .admin-new-stat {
    min-height: 90px;
    padding: 14px;
  }

  .admin-new-stat strong {
    font-size: 23px;
  }

  .admin-new-form-grid {
    grid-template-columns: 1fr;
    padding: 14px;
  }

  .admin-new-full {
    grid-column: auto;
  }

  .admin-new-card-head {
    padding: 11px 13px;
  }

  .admin-new-course-row {
    flex-wrap: wrap;
  }

  .admin-new-course-actions {
    width: 100%;
    padding-right: 56px;
  }

  .admin-new-inline-form {
    align-items: stretch;
    flex-direction: column;
  }
}

@media (max-width: 420px) {
  .admin-new-sidebar nav {
    grid-template-columns: 1fr 1fr;
  }

  .admin-new-sidebar nav button {
    min-height: 41px;
    font-size: 11px;
  }

  .admin-new-stats {
    grid-template-columns: 1fr 1fr;
  }

  .admin-new-course-actions {
    padding-right: 0;
  }

  .admin-new-course-actions button {
    flex: 1;
  }
}
