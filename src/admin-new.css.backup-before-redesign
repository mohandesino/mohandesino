.admin-new-login-logo {
  width: 52px;
  height: 52px;
  border-radius: 14px;
  background: #f2c94c;
  color: #3f3100;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  margin-bottom: 18px;
}

@media (max-width: 800px) {
