.admin-new-page {
  min-height: 100vh;
  display: flex;
  background: #f5f7fb;
  color: #172033;
  font-family: inherit;
}

/* ===== Sidebar ===== */

.admin-new-sidebar {
  width: 250px;
  min-height: 100vh;
  background: #ffffff;
  border-left: 1px solid #e8edf4;
  padding: 24px 16px;
  position: sticky;
  top: 0;
  align-self: flex-start;
}

.admin-new-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 8px 28px;
  border-bottom: 1px solid #edf1f6;
}

.admin-new-logo {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff4cf;
  font-size: 22px;
}

.admin-new-brand strong {
  display: block;
  font-size: 17px;
}

.admin-new-brand span {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: #8a94a6;
}

.admin-new-nav {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-top: 24px;
}

.admin-new-nav button {
  width: 100%;
  border: 0;
  background: transparent;
  color: #667085;
  padding: 13px 14px;
  border-radius: 12px;
  text-align: right;
  font-family: inherit;
  font-size: 14px;
  cursor: pointer;
  transition: 0.2s ease;
}

.admin-new-nav button:hover {
  background: #f7f9fc;
  color: #172033;
}

.admin-new-nav button.active {
  background: #fff4cf;
  color: #7a5b00;
  font-weight: 700;
}

/* ===== Main ===== */

.admin-new-content {
  flex: 1;
  min-width: 0;
}

.admin-new-topbar {
  min-height: 86px;
  background: #ffffff;
  border-bottom: 1px solid #e8edf4;
  padding: 18px 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.admin-new-topbar span {
  font-size: 12px;
  color: #98a2b3;
}

.admin-new-topbar h1 {
  margin: 4px 0 0;
  font-size: 22px;
}

.admin-new-user {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #667085;
  font-size: 13px;
}

.admin-new-user div {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: #f2f4f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-new-body {
  max-width: 1250px;
  margin: 0 auto;
  padding: 32px;
}

/* ===== Welcome ===== */

.admin-new-welcome {
  background: linear-gradient(135deg, #fffaf0, #ffffff);
  border: 1px solid #f0e6c8;
  border-radius: 20px;
  padding: 28px;
  margin-bottom: 22px;
}

.admin-new-welcome span {
  color: #9a7612;
  font-size: 13px;
  font-weight: 700;
}

.admin-new-welcome h2 {
  margin: 8px 0 7px;
  font-size: 25px;
}

.admin-new-welcome p {
  margin: 0;
  color: #667085;
  font-size: 14px;
}

/* ===== Stats ===== */

.admin-new-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 22px;
}

.admin-new-stat-card {
  background: #ffffff;
  border: 1px solid #e8edf4;
  border-radius: 18px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 14px;
}

.admin-new-stat-card > span {
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21px;
}

.admin-new-stat-card small {
  display: block;
  color: #8a94a6;
  font-size: 12px;
}

.admin-new-stat-card strong {
  display: block;
  margin-top: 4px;
  font-size: 22px;
}

/* ===== Panel ===== */

.admin-new-panel {
  background: #ffffff;
  border: 1px solid #e8edf4;
  border-radius: 20px;
  overflow: hidden;
}

.admin-new-panel-header {
  padding: 22px 24px;
  border-bottom: 1px solid #edf1f6;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.admin-new-panel-header span {
  font-size: 12px;
  color: #98a2b3;
}

.admin-new-panel-header h2 {
  margin: 4px 0 0;
  font-size: 19px;
}

.admin-new-primary-btn {
  border: 0;
  border-radius: 11px;
  background: #f2c94c;
  color: #3f3100;
  padding: 11px 17px;
  font-family: inherit;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  transition: 0.2s ease;
}

.admin-new-primary-btn:hover {
  transform: translateY(-1px);
  filter: brightness(0.97);
}

.admin-new-empty {
  padding: 70px 24px;
  text-align: center;
}

.admin-new-empty > div {
  width: 66px;
  height: 66px;
  border-radius: 18px;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
  font-size: 28px;
}

.admin-new-empty h3 {
  margin: 0;
  font-size: 17px;
}

.admin-new-empty p {
  margin: 8px 0 20px;
  color: #8a94a6;
  font-size: 13px;
}

/* ===== Mobile ===== */

@media (max-width: 850px) {
  .admin-new-page {
    display: block;
  }

  .admin-new-sidebar {
    width: 100%;
    min-height: auto;
    position: static;
    padding: 14px;
    border-left: 0;
    border-bottom: 1px solid #e8edf4;
  }

  .admin-new-brand {
    padding-bottom: 14px;
  }

  .admin-new-nav {
    flex-direction: row;
    overflow-x: auto;
    margin-top: 14px;
    padding-bottom: 2px;
  }

  .admin-new-nav button {
    min-width: max-content;
    text-align: center;
  }

  .admin-new-topbar {
    padding: 16px 18px;
  }

  .admin-new-body {
    padding: 18px;
  }

  .admin-new-stats {
    grid-template-columns: 1fr;
  }

  .admin-new-panel-header {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-new-primary-btn {
    width: 100%;
  }
}

/* ===== Course List ===== */

.admin-new-course-list {
  padding: 8px 0;
}

.admin-new-course-row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 24px;
  border-bottom: 1px solid #edf1f6;
  transition: background 0.2s ease;
}

.admin-new-course-row:last-child {
  border-bottom: 0;
}

.admin-new-course-row:hover {
  background: #fafbfc;
}

.admin-new-course-icon {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  border-radius: 14px;
  background: #fff4cf;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21px;
}

.admin-new-course-info {
  min-width: 0;
  flex: 1;
}

.admin-new-course-info strong {
  display: block;
  color: #172033;
  font-size: 14px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.admin-new-course-info span {
  display: block;
  margin-top: 5px;
  color: #98a2b3;
  font-size: 12px;
}

.admin-new-course-price {
  color: #667085;
  font-size: 12px;
  white-space: nowrap;
}

.admin-new-secondary-btn {
  border: 1px solid #e2e8f0;
  background: #ffffff;
  color: #475467;
  border-radius: 10px;
  padding: 9px 14px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: 0.2s ease;
}

.admin-new-secondary-btn:hover {
  border-color: #cbd5e1;
  background: #f8fafc;
}

.admin-new-error {
  margin: 18px 24px;
  padding: 13px 15px;
  border-radius: 12px;
  background: #fff1f2;
  color: #be123c;
  font-size: 13px;
  border: 1px solid #ffe4e6;
}

/* ===== Course List Mobile ===== */

@media (max-width: 650px) {
  .admin-new-course-row {
    flex-wrap: wrap;
    padding: 15px 16px;
  }

  .admin-new-course-info {
    flex-basis: calc(100% - 64px);
  }

  .admin-new-course-price {
    margin-right: 62px;
  }

  .admin-new-secondary-btn {
    margin-right: auto;
  }
}

/* ===== Course Detail ===== */

.admin-new-course-detail {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  padding: 24px;
  border-bottom: 1px solid #edf1f6;
}

.admin-new-detail-card {
  background: #f8fafc;
  border: 1px solid #edf1f6;
  border-radius: 14px;
  padding: 15px;
}

.admin-new-detail-card span {
  display: block;
  color: #98a2b3;
  font-size: 11px;
  margin-bottom: 7px;
}

.admin-new-detail-card strong {
  display: block;
  color: #172033;
  font-size: 14px;
}

.admin-new-course-description {
  padding: 20px 24px;
  border-bottom: 1px solid #edf1f6;
}

.admin-new-course-description > span {
  display: block;
  color: #667085;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 8px;
}

.admin-new-course-description p {
  margin: 0;
  color: #667085;
  font-size: 13px;
  line-height: 1.9;
}

/* ===== Content Section ===== */

.admin-new-content-section {
  padding: 24px;
}

.admin-new-content-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 18px;
}

.admin-new-content-section-header span {
  display: block;
  color: #98a2b3;
  font-size: 11px;
}

.admin-new-content-section-header h3 {
  margin: 5px 0 0;
  font-size: 17px;
}

/* ===== Chapters ===== */

.admin-new-chapters {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.admin-new-chapter {
  border: 1px solid #e8edf4;
  border-radius: 15px;
  overflow: hidden;
  background: #fff;
}

.admin-new-chapter-header {
  padding: 16px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  background: #fafbfc;
}

.admin-new-chapter-title {
  min-width: 0;
}

.admin-new-chapter-title span {
  display: block;
  color: #9a7612;
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 5px;
}

.admin-new-chapter-title strong {
  display: block;
  color: #172033;
  font-size: 14px;
}

.admin-new-chapter-meta {
  color: #8a94a6;
  background: #fff;
  border: 1px solid #e5e9ef;
  padding: 6px 10px;
  border-radius: 20px;
  font-size: 11px;
  white-space: nowrap;
}

/* ===== Lessons ===== */

.admin-new-lessons {
  border-top: 1px solid #edf1f6;
}

.admin-new-lesson {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 18px;
  border-bottom: 1px solid #f0f2f5;
}

.admin-new-lesson:last-child {
  border-bottom: 0;
}

.admin-new-lesson-number {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  border-radius: 9px;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 11px;
  font-weight: 700;
}

.admin-new-lesson-info {
  min-width: 0;
  flex: 1;
}

.admin-new-lesson-info strong {
  display: block;
  color: #344054;
  font-size: 13px;
}

.admin-new-lesson-info span {
  display: block;
  margin-top: 4px;
  color: #98a2b3;
  font-size: 11px;
}

/* ===== Detail Mobile ===== */

@media (max-width: 850px) {
  .admin-new-course-detail {
    grid-template-columns: repeat(2, 1fr);
    padding: 18px;
  }

  .admin-new-course-description,
  .admin-new-content-section {
    padding: 18px;
  }

  .admin-new-content-section-header {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-new-content-section-header .admin-new-primary-btn {
    width: 100%;
  }
}

@media (max-width: 500px) {
  .admin-new-course-detail {
    grid-template-columns: 1fr;
  }

  .admin-new-chapter-header {
    align-items: flex-start;
    flex-direction: column;
  }
}

/* فرم افزودن فصل */
.admin-new-chapter-form {
  margin-top: 18px;
  padding: 20px;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  background: #fafafa;
}

.admin-new-form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.admin-new-form-group label {
  font-size: 14px;
  font-weight: 700;
  color: #374151;
}

.admin-new-form-group input {
  width: 100%;
  box-sizing: border-box;
  min-height: 46px;
  padding: 0 14px;
  border: 1px solid #d1d5db;
  border-radius: 12px;
  background: #fff;
  color: #111827;
  font-family: inherit;
  font-size: 14px;
  outline: none;
  direction: rtl;
  text-align: right;
  transition: border-color .2s, box-shadow .2s;
}

.admin-new-form-group input:focus {
  border-color: #f0b429;
  box-shadow: 0 0 0 3px rgba(240, 180, 41, .12);
}

.admin-new-form-actions {
  display: flex;
  gap: 10px;
  margin-top: 16px;
  flex-wrap: wrap;
}

@media (max-width: 640px) {
  .admin-new-chapter-form {
    padding: 16px;
  }

  .admin-new-form-actions {
    flex-direction: column;
  }

  .admin-new-form-actions button {
    width: 100%;
  }
}

